# Copy to upc_agent/.env and fill in ONE of the two options.

# Option A: Gemini API key (AI Studio)
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=your-api-key

# Option B: Vertex AI (run `gcloud auth application-default login` first)
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=us-central1

# Optional: override the model (default gemini-3.5-flash)
# UPC_AGENT_MODEL=gemini-3.5-flash
