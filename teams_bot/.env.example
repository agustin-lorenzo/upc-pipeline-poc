# Copy to teams_bot/.env. The Gemini key comes from upc_agent/.env (shared with `adk web`).

# Bot credentials: from the Azure Bot registration / Entra app registration.
# Needs an admin or IT; leave blank until you have them.
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__CLIENTID=
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__CLIENTSECRET=
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__TENANTID=

# Local testing only (e.g. Agents Playground): skip authentication. Never set this on a server.
# TEAMS_BOT_ALLOW_ANONYMOUS=true

# Optional
# PORT=3978
# HOST=localhost
